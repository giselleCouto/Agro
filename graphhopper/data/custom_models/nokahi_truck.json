{
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "max_weight < 57", "multiply_by": "0" },
    { "if": "max_height < 4.4", "multiply_by": "0" },
    { "if": "max_width < 2.6", "multiply_by": "0" },
    { "if": "road_class == LIVING_STREET", "multiply_by": "0" },
    { "if": "road_class == RESIDENTIAL", "multiply_by": "0.15" },
    { "if": "road_class == TRACK", "multiply_by": "0.6" },
    { "if": "road_environment == FERRY", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" },
    { "if": "true", "limit_to": "80" },
    { "if": "surface == GRAVEL || surface == FINE_GRAVEL || surface == COMPACTED", "limit_to": "45" },
    { "if": "surface == DIRT || surface == GROUND || surface == UNPAVED", "limit_to": "30" },
    { "if": "surface == SAND", "limit_to": "20" },
    { "if": "road_class == TRACK", "limit_to": "25" }
  ]
}
