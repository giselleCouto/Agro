# NOKAHI AgroRoute — variáveis de ambiente
# Copie para .env e preencha. O .env é carregado automaticamente na inicialização.

# ---- Domínio / deploy ----
# URL pública canônica do serviço (usada em checkout Stripe, webhook, links).
PUBLIC_BASE_URL=https://agroroute.despaxai.com
# hosts aceitos (bloqueia Host spoofing); vazio = qualquer
ALLOWED_HOSTS=agroroute.despaxai.com
# atrás de proxy reverso (Caddy/nginx) que termina o HTTPS
AGROROUTE_TRUST_PROXY=1
# origens CORS (se a API for consumida por outro site); vazio = só mesma origem
CORS_ORIGINS=

# ---- Banco de dados ----
# Padrão: SQLite local (data/nokahi.db). Produção: PostgreSQL.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nokahi

# ---- Stripe (cobrança recorrente mensal) ----
# 1) Pegue a Secret Key no painel: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# 2) Rode:  python -m agroroute.stripe_setup
#    O script cria os produtos/prices e preenche estas duas linhas:
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=

# 3) Configure o webhook (POST /v1/billing/webhook) no painel do Stripe
#    e cole aqui o "Signing secret" (whsec_...). Sem ele, o webhook é recusado.
STRIPE_WEBHOOK_SECRET=

# ---- Admin (painel de leads em /admin) ----
# OBRIGATÓRIO para habilitar /admin. Sem isso, os endpoints de admin ficam
# desativados (503). Gere um token forte, NÃO use um valor previsível:
#   python -c "import secrets; print(secrets.token_hex(24))"
AGROROUTE_ADMIN_TOKEN=

# ---- Proxy (rate limit por IP) ----
# defina como 1 apenas se a API roda atrás de um proxy reverso confiável
# (ex.: nginx) que já sanitiza o cabeçalho X-Forwarded-For
AGROROUTE_TRUST_PROXY=

# ---- E-mail (notificação de leads) ----
# Sem SMTP_HOST, os leads só são gravados no banco/painel (não enviam e-mail).
# Os leads são notificados para contato@nokahi.com e giselle@coutofalcao.com
# (personalize em LEAD_NOTIFY_EMAILS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nokahi.com
SMTP_SSL=
LEAD_NOTIFY_EMAILS=contato@nokahi.com,giselle@coutofalcao.com
