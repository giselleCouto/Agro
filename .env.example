# ============================================================
# CanaRoute - Configuração de Ambiente
# ============================================================

# Database
DB_USER=canaroute
DB_PASSWORD=canaroute_secret

# Backend
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development

# Roteamento
OSRM_URL=http://osrm:5000
OSRM_PUBLIC_URL=http://router.project-osrm.org
GRAPHHOPPER_URL=http://graphhopper:8989

# Modelo de Consumo (defaults)
FUEL_R0=0.0030
FUEL_ALPHA=0.0040
FUEL_SLOPE_CLIP=6.0
FUEL_PRICE_PER_LITER=6.00

# Safra
SAFRA_DAYS=220
SAFRA_AVAILABILITY=0.85
TRIPS_PER_DAY=5

# SRTM
SRTM_DATA_DIR=/app/data/srtm
